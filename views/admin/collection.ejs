<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= title %></title><style>body{font:15px system-ui;background:#0b1220;color:#e8eefc;margin:0;padding:24px}a{color:#8bd5ca}article{background:#121c2e;padding:14px;margin:12px 0;border-radius:10px}input,textarea,button{padding:10px;margin:5px;background:#0b1220;color:white;border:1px solid #41506a}textarea{width:95%;min-height:70px}label{display:inline-block}small{color:#ffcf80}</style></head><body><a href="/admin">← Dashboard</a><h1><%= title %></h1><% if(warning){ %><p><strong><%= warning %></strong></p><% } %><form id="create"><% fields.forEach(f=>{ %><label><%= f %><br><input name="<%= f %>" placeholder="<%= f %>" <%= ['published','approved','announcementEnabled','chatLogsEnabled'].includes(f)?'type=checkbox':'' %>></label><% }) %><button>Create</button></form><% items.forEach(item=>{ %><article><strong><%= item.title || item.name || 'Site settings' %></strong> <small><%= item.slug || '' %></small><pre><%= JSON.stringify(item,null,2) %></pre><button onclick="if(confirm('Delete this item?'))fetch('/api/admin/<%= kind %>/<%= item._id %>',{method:'DELETE'}).then(()=>location.reload())">Delete</button></article><% }) %><script>document.getElementById('create').addEventListener('submit',async e=>{e.preventDefault();const d={};new FormData(e.target).forEach((v,k)=>d[k]=v);e.target.querySelectorAll('input[type=checkbox]').forEach(x=>d[x.name]=x.checked);for(const k of ['results','techTags','gallery','features'])if(typeof d[k]==='string')d[k]=d[k].split(',').map(s=>s.trim()).filter(Boolean);const url='<%= kind %>'==='settings'?'/api/admin/settings/current':'/api/admin/<%= kind %>';const method='<%= kind %>'==='settings'?'PUT':'POST';const r=await fetch(url,{method,headers:{'Content-Type':'application/json'},body:JSON.stringify(d)});if(r.ok)location.reload();else alert('Could not save. Check the fields and try again.');});</script></body></html>
