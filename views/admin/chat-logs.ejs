<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="robots" content="noindex,nofollow"><title>Chat logs</title></head><body><a href="/admin">← Dashboard</a><h1>AI chat logs</h1><p>Privacy notice: conversations may contain personal information. Review only for service quality and retain only as needed.</p><% if(disabled){ %><p>Chat log storage is off in Site settings.</p><% }else{ %><form method="post" action="/admin/chat-logs/delete-all" onsubmit="return confirm('Delete every stored chat log?')"><button>Delete all chat logs</button></form><% items.forEach(item=>{ %><article><time><%= item.createdAt.toISOString() %></time><pre><%= JSON.stringify(item.messages,null,2) %></pre></article><% }) %><% } %></body></html>
