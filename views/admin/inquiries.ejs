<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Inquiries</title><style>body{font:15px system-ui;background:#0b1220;color:#e8eefc;margin:0;padding:24px}a{color:#8bd5ca}table{width:100%;border-collapse:collapse;margin-top:20px}td,th{text-align:left;padding:10px;border-bottom:1px solid #334}button,select{padding:8px;background:#121c2e;color:white;border:1px solid #41506a}</style></head><body><a href="/admin">← Dashboard</a><h1>Inquiries</h1><a href="/api/admin/inquiries.csv">Export CSV</a><table><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Service</th><th>Status</th><th>Message</th></tr></thead><tbody><% items.forEach(i=>{ %><tr><td><%= i.name %></td><td><%= i.email %></td><td><%= i.phone || '' %></td><td><%= i.service || '' %></td><td><select aria-label="Status" onchange="fetch('/api/admin/inquiries/<%= i._id %>',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:this.value})})"><% ['New','Contacted','Qualified','Won','Lost'].forEach(s=>{ %><option <%= i.status===s?'selected':'' %>><%= s %></option><% }) %></select></td><td><details><summary>View</summary><p><%= i.message %></p><% (i.notes||[]).forEach(n=>{ %><p><%= n.body %> · <%= n.author %></p><% }) %><textarea id="note-<%= i._id %>" placeholder="Internal note"></textarea><button onclick="fetch('/api/admin/inquiries/<%= i._id %>',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({note:document.getElementById('note-<%= i._id %>').value})}).then(()=>location.reload())">Add note</button></details></td></tr><% }) %></tbody></table></body></html>
