<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Inquiries</title><style>body{font:15px system-ui;background:#090b12;color:#f7f8fb;margin:0;padding:24px}a{color:#c8ff6b}table{width:100%;border-collapse:collapse;margin-top:20px}td,th{text-align:left;padding:10px;border-bottom:1px solid #ffffff25}button,select{padding:8px;background:#111521;color:white;border:1px solid #ffffff30}</style></head><body><a href="/admin">← Dashboard</a><h1>Inquiries</h1><a href="/api/admin/inquiries.csv">Export CSV</a><table><tr><th>Name</th><th>Email</th><th>Phone</th><th>Service</th><th>Status</th><th>Message / notes</th></tr><% items.forEach(i=>{ %><tr><td><%= i.name %></td><td><%= i.email %></td><td><%= i.phone||'' %></td><td><%= i.service||'' %></td><td><select aria-label="Status" onchange="fetch('/api/admin/inquiries/<%= i._id %>',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:this.value})})"><% ['New','Contacted','Qualified','Won','Lost'].forEach(s=>{ %><option <%= i.status===s?'selected':'' %>><%= s %></option><% }) %></select></td><td><details><summary>View</summary><p><%= i.message %></p><% (i.notes||[]).forEach(n=>{ %><p><%= n.body %></p><% }) %><textarea id="note-<%= i._id %>" placeholder="Internal note"></textarea><button onclick="fetch('/api/admin/inquiries/<%= i._id %>',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({note:document.getElementById('note-<%= i._id %>').value})}).then(()=>location.reload())">Add note</button><button onclick="if(confirm('Delete inquiry?'))fetch('/api/admin/inquiries/<%= i._id %>',{method:'DELETE'}).then(()=>location.reload())">Delete</button><a href="mailto:<%= i.email %>">Reply by email</a><% if(i.phone){ %><a target="_blank" rel="noopener" href="https://wa.me/<%= i.phone.replace(/\D/g,'') %>">WhatsApp</a><% } %></details></td></tr><% }) %></table></body></html>
