<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="robots" content="noindex,nofollow"><title>Audit log</title><style>body{font:15px system-ui;background:#090b12;color:#f7f8fb;padding:24px}a{color:#c8ff6b}table{width:100%;border-collapse:collapse}td,th{padding:8px;border-bottom:1px solid #ffffff25;text-align:left}</style></head><body><a href="/admin">← Dashboard</a><h1>Audit log</h1><table><tr><th>When</th><th>Actor</th><th>Action</th><th>Entity</th><th>ID</th></tr><% entries.forEach(e=>{ %><tr><td><%= e.createdAt.toISOString() %></td><td><%= e.actor %></td><td><%= e.action %></td><td><%= e.entity %></td><td><%= e.entityId||'' %></td></tr><% }) %></table></body></html>
