<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>Admin dashboard</title><style>body{margin:0;font:15px system-ui;background:#090b12;color:#f7f8fb}header,main{max-width:1180px;margin:auto;padding:20px}header{display:flex;justify-content:space-between;align-items:center;gap:15px;flex-wrap:wrap}nav{display:flex;gap:14px;flex-wrap:wrap}a{color:#c8ff6b}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:14px}.card,section{background:#111521;border:1px solid #ffffff18;border-radius:14px;padding:18px;margin:12px 0}.value{font-size:28px;font-weight:700}li{margin:8px 0}table{width:100%;border-collapse:collapse}td,th{text-align:left;padding:9px;border-bottom:1px solid #ffffff20}</style></head><body><header><strong>Dcore Lab · Admin</strong><nav><a href="/admin">Dashboard</a><a href="/admin/inquiries">Inquiries</a><a href="/admin/projects">Projects</a><a href="/admin/testimonials">Testimonials</a><a href="/admin/services">Services</a><a href="/admin/settings">Settings</a><a href="/admin/chat-logs">Chat logs</a><a href="/admin/audit-log">Audit log</a><a href="/admin/account">Account</a><form method="post" action="/admin/logout"><button>Log out</button></form></nav></header><main><h1>Dashboard</h1><p>Welcome, <%= admin.email %></p><div class="cards"><% [['Visits',metrics.visits],['Unique visitors',metrics.uniques],['Visitors today',metrics.visitorsToday],['Inquiries',metrics.inquiries],['Conversion',metrics.conversion+'%']].forEach(([label,value])=>{ %><div class="card"><div><%= label %></div><div class="value"><%= value %></div></div><% }) %></div><section><h2>Visits · last 7 days</h2><table><tr><th>Date</th><th>Visits</th></tr><% JSON.parse(chart).forEach(d=>{ %><tr><td><%= d._id %></td><td><%= d.visits %></td></tr><% }) %></table></section><section><h2>Top referrers</h2><ul><% topRefs.forEach(r=>{ %><li><%= r._id||'Direct' %> · <%= r.count %></li><% }) %></ul></section><section><h2>Latest inquiries</h2><table><tr><th>Name</th><th>Email</th><th>Status</th></tr><% latest.forEach(i=>{ %><tr><td><%= i.name %></td><td><%= i.email %></td><td><%= i.status %></td></tr><% }) %></table></section></main></body></html>
