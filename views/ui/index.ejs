<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#090b12">
  <meta name="description" content="<%= description %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:type" content="website">
  <meta name="robots" content="index,follow">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root{--bg:#090b12;--panel:#111521;--line:rgba(255,255,255,.11);--muted:#a3a9ba;--text:#f7f8fb;--lime:#c8ff6b;--violet:#9d8cff;--cyan:#74e7ef;--max:1180px}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;line-height:1.6;overflow-x:hidden}body:before{content:'';position:fixed;inset:0;pointer-events:none;z-index:-1;background:radial-gradient(ellipse at 75% 4%,rgba(107,83,255,.15),transparent 38%),radial-gradient(ellipse at 10% 40%,rgba(31,222,210,.08),transparent 36%),linear-gradient(180deg,#090b12,#0b0e17 60%,#090b12)}a{color:inherit;text-decoration:none}button,input,textarea,select{font:inherit}.wrap{width:min(var(--max),calc(100% - 48px));margin:auto}.announcement{padding:9px 16px;text-align:center;background:var(--lime);color:#111;font-size:.82rem;font-weight:700}.nav{position:sticky;top:0;z-index:10;background:rgba(9,11,18,.78);backdrop-filter:blur(18px);border-bottom:1px solid var(--line)}.nav-inner{height:76px;display:flex;align-items:center;justify-content:space-between}.brand{font-family:'Space Grotesk';font-weight:700;font-size:1.35rem;letter-spacing:-.06em}.brand-mark{display:inline-grid;place-items:center;width:34px;height:34px;margin-right:8px;border-radius:11px;background:var(--lime);color:#10130b;transform:rotate(-8deg)}.nav-links{display:flex;align-items:center;gap:30px;color:#c6c9d2;font-size:.92rem}.nav-links a:hover{color:var(--lime)}.button{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:13px 19px;border-radius:999px;background:var(--lime);color:#11150b;font-weight:700;border:0;cursor:pointer;transition:transform .2s,box-shadow .2s}.button:hover{transform:translateY(-2px);box-shadow:0 12px 35px rgba(200,255,107,.18)}.button.secondary{color:var(--text);background:rgba(255,255,255,.06);border:1px solid var(--line)}.menu-button{display:none;background:none;border:0;color:white;font-size:1.4rem}.hero{position:relative;min-height:670px;display:grid;align-items:center;padding:90px 0 110px;overflow:hidden}.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:38px;align-items:center}.eyebrow{display:inline-flex;align-items:center;gap:9px;color:var(--lime);font-size:.77rem;letter-spacing:.16em;text-transform:uppercase;font-weight:700}.pulse{width:7px;height:7px;border-radius:50%;background:var(--lime);box-shadow:0 0 15px var(--lime)}h1,h2,h3,p{margin-top:0}h1,h2,h3{font-family:'Space Grotesk',sans-serif;line-height:1.08;letter-spacing:-.045em}.hero h1{max-width:740px;font-size:clamp(3.1rem,7vw,6.6rem);margin:23px 0}.gradient{background:linear-gradient(100deg,var(--lime),var(--cyan) 48%,var(--violet));color:transparent;background-clip:text}.hero-copy{max-width:560px;color:var(--muted);font-size:1.1rem;margin-bottom:28px}.hero-actions{display:flex;gap:12px;flex-wrap:wrap}.hero-meta{display:flex;align-items:center;gap:15px;margin-top:45px;color:#9298aa;font-size:.85rem}.avatar-stack{display:flex}.avatar-stack i{display:grid;place-items:center;width:29px;height:29px;margin-right:-7px;border-radius:50%;border:2px solid var(--bg);background:linear-gradient(135deg,#83ede1,#7567fa);color:#111;font-size:.65rem;font-style:normal;font-weight:800}.stage{height:490px;position:relative;display:grid;place-items:center;perspective:1000px}.orbital{position:absolute;width:380px;height:380px;border:1px solid rgba(200,255,107,.23);border-radius:50%;transform:rotateX(68deg) rotateZ(-20deg);box-shadow:0 0 70px rgba(116,231,239,.08),inset 0 0 55px rgba(157,140,255,.07);animation:orbit 22s linear infinite}.orbital:before,.orbital:after{content:'';position:absolute;border:1px solid rgba(157,140,255,.25);border-radius:50%;inset:28px;transform:rotate(58deg)}.orbital:after{inset:65px;border-color:rgba(116,231,239,.24);transform:rotate(-40deg)}.core{position:relative;width:210px;height:210px;display:grid;place-items:center;border-radius:38% 62% 65% 35%/43% 43% 57% 57%;background:linear-gradient(145deg,rgba(200,255,107,.86),rgba(116,231,239,.8) 44%,rgba(157,140,255,.9));box-shadow:inset -18px -20px 50px rgba(18,16,44,.4),inset 10px 12px 30px rgba(255,255,255,.65),0 25px 100px rgba(116,231,239,.25);transform:rotate(-17deg);animation:morph 9s ease-in-out infinite alternate}.core span{font:700 4rem 'Space Grotesk';color:#151724;text-shadow:0 3px 20px #fff8;transform:rotate(17deg)}.float-card{position:absolute;padding:13px 16px;border:1px solid rgba(255,255,255,.14);border-radius:14px;background:rgba(20,25,39,.74);backdrop-filter:blur(12px);box-shadow:0 15px 50px #0005;font-size:.83rem;animation:float 5s ease-in-out infinite}.float-card strong{display:block;color:var(--lime);font:600 1.1rem 'Space Grotesk'}.float-one{top:46px;right:4%;animation-delay:-2s}.float-two{left:0;bottom:67px;animation-delay:-1s}.float-three{right:0;bottom:85px;animation-delay:-3s}.spark{position:absolute;width:5px;height:5px;border-radius:50%;background:#fff;box-shadow:0 0 14px var(--cyan)}.spark.s1{top:17%;left:18%}.spark.s2{right:12%;top:30%}.spark.s3{bottom:15%;left:35%}@keyframes orbit{to{transform:rotateX(68deg) rotateZ(340deg)}}@keyframes float{50%{transform:translateY(-12px)}}@keyframes morph{to{border-radius:57% 43% 37% 63%/56% 63% 37% 44%;transform:rotate(12deg) scale(.96)}}.strip{border-block:1px solid var(--line);padding:20px 0;color:#979caf;font-size:.8rem;text-transform:uppercase;letter-spacing:.13em}.strip-inner{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}.section{padding:105px 0}.section-head{max-width:720px;margin-bottom:44px}.section h2{font-size:clamp(2.3rem,5vw,4.2rem);margin:13px 0 18px}.section-head p{color:var(--muted);font-size:1.04rem}.service-grid,.project-grid,.quote-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.card{position:relative;overflow:hidden;border:1px solid var(--line);border-radius:22px;background:linear-gradient(145deg,rgba(255,255,255,.055),rgba(255,255,255,.018));padding:27px;transition:transform .25s,border-color .25s,background .25s}.card:hover{transform:translateY(-6px);border-color:rgba(200,255,107,.45);background:linear-gradient(145deg,rgba(200,255,107,.07),rgba(255,255,255,.025))}.card-number{color:var(--lime);font:600 .85rem 'Space Grotesk'}.card h3{font-size:1.35rem;margin:21px 0 10px;letter-spacing:-.03em}.card p{color:var(--muted);font-size:.94rem;margin-bottom:0}.service-icon{width:46px;height:46px;display:grid;place-items:center;border-radius:14px;background:rgba(200,255,107,.1);color:var(--lime);font-size:1.25rem}.project-card{padding:0}.project-art{height:205px;display:grid;place-items:center;background:radial-gradient(circle at 30% 30%,rgba(200,255,107,.3),transparent 28%),linear-gradient(135deg,#202842,#121524 70%);overflow:hidden}.project-art img{width:100%;height:100%;object-fit:cover}.project-symbol{font:700 4.7rem 'Space Grotesk';color:rgba(255,255,255,.8);transform:rotate(-8deg);text-shadow:0 15px 40px #000}.project-body{padding:23px}.tag{display:inline-block;padding:5px 9px;margin:3px 4px 0 0;border-radius:999px;background:#ffffff0d;color:#c1c6d3;font-size:.72rem}.quote{font-size:1.05rem!important;color:#e5e7ee!important}.person{display:flex;gap:12px;align-items:center;margin-top:22px}.person img,.person-avatar{width:42px;height:42px;border-radius:50%;object-fit:cover;background:linear-gradient(135deg,var(--cyan),var(--violet));display:grid;place-items:center;color:#111;font-weight:700}.person small{display:block;color:var(--muted)}.empty{grid-column:1/-1;border:1px dashed var(--line);padding:30px;border-radius:18px;color:var(--muted);text-align:center}.contact{padding:85px 0 110px}.contact-panel{display:grid;grid-template-columns:.9fr 1.1fr;gap:50px;padding:clamp(25px,5vw,58px);border:1px solid var(--line);border-radius:28px;background:radial-gradient(ellipse at 5% 0,rgba(157,140,255,.16),transparent 42%),#111521}.contact-panel h2{font-size:clamp(2.4rem,5vw,4rem);margin:17px 0}.contact-panel p{color:var(--muted)}.contact-details{display:grid;gap:14px;margin-top:28px;color:#d9dce6}.contact-details a:hover{color:var(--lime)}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.field{display:grid;gap:7px}.field.full{grid-column:1/-1}.field label{font-size:.82rem;color:#c5c9d5}.field input,.field textarea,.field select{width:100%;padding:13px 14px;border:1px solid var(--line);border-radius:12px;background:#090c14;color:white;outline:none}.field input:focus,.field textarea:focus,.field select:focus{border-color:var(--lime)}.field textarea{min-height:115px;resize:vertical}.notice{min-height:24px;color:var(--lime);font-size:.9rem}.footer{border-top:1px solid var(--line);padding:28px 0;color:#8f95a6;font-size:.85rem}.footer-inner{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}.mobile-menu{display:none}.reveal{opacity:0;transform:translateY(18px);transition:opacity .7s ease,transform .7s ease}.reveal.visible{opacity:1;transform:none}@media(max-width:850px){.hero-grid{grid-template-columns:1fr}.hero{padding-top:70px}.stage{height:380px}.orbital{width:300px;height:300px}.core{width:170px;height:170px}.service-grid,.project-grid,.quote-grid{grid-template-columns:repeat(2,1fr)}.contact-panel{grid-template-columns:1fr}.nav-links{gap:16px}}@media(max-width:620px){.wrap{width:min(var(--max),calc(100% - 32px))}.nav-inner{height:66px}.nav-links{display:none}.menu-button{display:block}.mobile-menu.open{display:grid;gap:14px;padding:10px 0 20px;color:#c6c9d2}.hero{min-height:0;padding:65px 0 70px}.hero h1{font-size:clamp(3rem,14vw,5rem)}.hero-meta{margin-top:30px}.stage{height:320px}.orbital{width:250px;height:250px}.core{width:140px;height:140px}.core span{font-size:3.3rem}.float-card{font-size:.72rem;padding:10px}.section{padding:75px 0}.service-grid,.project-grid,.quote-grid{grid-template-columns:1fr}.strip-inner{justify-content:center}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.contact{padding:50px 0 70px}}
    @media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}.reveal{opacity:1;transform:none}}
  </style>
</head>
<body>
  <% if (settings.announcementEnabled && settings.announcementText) { %><div class="announcement"><%= settings.announcementText %></div><% } %>
  <nav class="nav"><div class="wrap"><div class="nav-inner"><a class="brand" href="#home"><span class="brand-mark">D</span>DCORE LAB</a><div class="nav-links"><a href="#services">Services</a><a href="#work">Selected work</a><a href="#about">Studio</a><a href="#contact" class="button">Let’s talk <span aria-hidden="true">↗</span></a></div><button class="menu-button" id="menuButton" aria-label="Open navigation" aria-expanded="false">☰</button></div><div class="mobile-menu" id="mobileMenu"><a href="#services">Services</a><a href="#work">Selected work</a><a href="#about">Studio</a><a href="#contact">Let’s talk ↗</a></div></div></nav>
  <main>
    <section class="hero" id="home"><div class="wrap hero-grid"><div><div class="eyebrow"><span class="pulse"></span> Independent digital studio · Kolkata & everywhere</div><h1><%= settings.heroHeadline %></h1><p class="hero-copy"><%= settings.heroSubHeadline %></p><div class="hero-actions"><a class="button" href="#contact">Start a project <span aria-hidden="true">↗</span></a><a class="button secondary" href="#work">Explore our work</a></div><div class="hero-meta"><div class="avatar-stack"><i>D</i><i>C</i><i>L</i></div><span>Small team. Big energy. Built for what’s next.</span></div></div><div class="stage" aria-label="Abstract three-dimensional Dcore Lab artwork"><div class="orbital"></div><div class="core"><span>D.</span></div><div class="float-card float-one"><strong>01 — 04</strong>Ideas to impact</div><div class="float-card float-two"><strong>Design × Tech</strong>Made to work beautifully</div><div class="float-card float-three"><strong>Always curious</strong>Always building</div><i class="spark s1"></i><i class="spark s2"></i><i class="spark s3"></i></div></div></section>
    <div class="strip"><div class="wrap strip-inner"><span>Product strategy</span><span>✳</span><span>Brand & experience</span><span>✳</span><span>Web engineering</span><span>✳</span><span>Growth systems</span></div></div>
    <section class="section" id="services"><div class="wrap"><div class="section-head reveal"><div class="eyebrow">What we do</div><h2>Make the complex feel <span class="gradient">effortless.</span></h2><p>From the first sketch to the last line of code, we bring the right people and craft together to solve meaningful problems.</p></div><div class="service-grid"><% if (services.length) { services.forEach((service,index)=>{ %><article class="card reveal"><span class="service-icon" aria-hidden="true"><%= service.icon || '✳' %></span><h3><%= service.title %></h3><p><%= service.description || '' %></p><% if (service.features && service.features.length) { %><div style="margin-top:16px"><% service.features.slice(0,4).forEach(feature=>{ %><span class="tag"><%= feature %></span><% }) %></div><% } %></article><% }) } else { %><article class="card reveal"><span class="card-number">01</span><h3>Digital products</h3><p>Thoughtful web platforms and software that turn useful ideas into products people love using.</p></article><article class="card reveal"><span class="card-number">02</span><h3>Brand & experience</h3><p>Distinctive identity systems and clear, intuitive experiences built around your customers.</p></article><article class="card reveal"><span class="card-number">03</span><h3>Growth engineering</h3><p>Search, performance and conversion work that makes every digital touchpoint count.</p></article><% } %></div></div></section>
    <section class="section" id="work" style="background:linear-gradient(180deg,transparent,rgba(255,255,255,.018),transparent)"><div class="wrap"><div class="section-head reveal"><div class="eyebrow">Selected work</div><h2>Good work gets <span class="gradient">noticed.</span></h2><p>A few ways we help teams move from a big ambition to something real and measurable.</p></div><div class="project-grid"><% if (projects.length) { projects.forEach((project,index)=>{ %><article class="card project-card reveal"><div class="project-art"><% if (project.coverImage) { %><img src="<%= project.coverImage %>" alt="<%= project.title %>" loading="lazy"><% } else { %><span class="project-symbol"><%= (project.title || 'D.').slice(0,2).toUpperCase() %></span><% } %></div><div class="project-body"><span class="card-number"><%= project.category || 'CASE STUDY' %> · <%= String(index+1).padStart(2,'0') %></span><h3><%= project.title %></h3><p><%= project.shortDescription || '' %></p><% if (project.results && project.results.length) { %><div style="margin-top:14px"><% project.results.slice(0,2).forEach(result=>{ %><span class="tag"><%= result %></span><% }) %></div><% } %></div></article><% }) } else { %><div class="empty">Our next case study could be yours. Get in touch to make something remarkable.</div><% } %></div></div></section>
    <section class="section" id="about"><div class="wrap"><div class="section-head reveal"><div class="eyebrow">A little about us</div><h2>Curiosity is our <span class="gradient">unfair advantage.</span></h2><p>We’re a close-knit crew of strategists, designers and developers who care about the details—and the difference the details make. No bloated process. No off-the-shelf thinking. Just thoughtful collaboration and useful outcomes.</p></div><div class="service-grid"><div class="card reveal"><span class="card-number">01 / THINK</span><h3>Ask better questions</h3><p>We get close to the people and problems behind every brief before we start making.</p></div><div class="card reveal"><span class="card-number">02 / MAKE</span><h3>Craft with intention</h3><p>We pair expressive design with robust engineering to create work that lasts.</p></div><div class="card reveal"><span class="card-number">03 / GROW</span><h3>Measure what matters</h3><p>We help you learn from real-world use and keep improving after launch.</p></div></div></div></section>
    <% if (testimonials.length) { %><section class="section" id="kind-words"><div class="wrap"><div class="section-head reveal"><div class="eyebrow">Kind words</div><h2>Better together.</h2></div><div class="quote-grid"><% testimonials.forEach(item=>{ %><article class="card reveal"><p class="quote">“<%= item.quote %>”</p><div class="person"><% if(item.photo){ %><img src="<%= item.photo %>" alt="<%= item.name %>" loading="lazy"><% }else{ %><span class="person-avatar"><%= (item.name||'').charAt(0).toUpperCase() %></span><% } %><div><strong><%= item.name %></strong><small><%= [item.role,item.company].filter(Boolean).join(' · ') %></small></div></div></article><% }) %></div></div></section><% } %>
    <section class="contact" id="contact"><div class="wrap contact-panel"><div><div class="eyebrow"><span class="pulse"></span> Have a good one in mind?</div><h2>Let’s make your next move <span class="gradient">count.</span></h2><p>Tell us what you’re trying to do. We’ll get back to you and figure out the best next step together.</p><div class="contact-details"><% if(settings.email){ %><a href="mailto:<%= settings.email %>">↗ &nbsp;<%= settings.email %></a><% } %><% if(settings.phone){ %><a href="tel:<%= settings.phone %>">↗ &nbsp;<%= settings.phone %></a><% } %><% if(settings.address){ %><span>⌖ &nbsp;<%= settings.address %></span><% } %><% if(settings.workingHours){ %><span>◷ &nbsp;<%= settings.workingHours %></span><% } %></div></div><form id="contactForm"><div class="form-grid"><div class="field"><label for="name">Your name</label><input id="name" name="name" autocomplete="name" required maxlength="120" placeholder="Alex Morgan"></div><div class="field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder="alex@company.com"></div><div class="field"><label for="company">Company</label><input id="company" name="company" autocomplete="organization" maxlength="120" placeholder="Your team"></div><div class="field"><label for="service">What do you need?</label><select id="service" name="service"><option value="">Choose a service</option><% services.forEach(service=>{ %><option value="<%= service.title %>"><%= service.title %></option><% }) %><option value="Other">Something else</option></select></div><div class="field full"><label for="message">A little about the project</label><textarea id="message" name="message" required maxlength="5000" placeholder="What are you building, changing or figuring out?"></textarea></div><div class="field full"><button class="button" type="submit">Send your inquiry <span aria-hidden="true">↗</span></button><div class="notice" id="formNotice" role="status" aria-live="polite"></div></div></div></form></div></section>
  </main>
  <footer class="footer"><div class="wrap footer-inner"><a class="brand" href="#home"><span class="brand-mark">D</span>DCORE LAB</a><span>Independent by nature. Connected by design.</span><span>© <%= new Date().getFullYear() %> Dcore Lab</span></div></footer>
  <script>
    const menuButton=document.getElementById('menuButton'),mobileMenu=document.getElementById('mobileMenu');menuButton.addEventListener('click',()=>{const open=mobileMenu.classList.toggle('open');menuButton.setAttribute('aria-expanded',String(open));});mobileMenu.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{mobileMenu.classList.remove('open');menuButton.setAttribute('aria-expanded','false');}));
    const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('visible');observer.unobserve(entry.target);}}),{threshold:.12});document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));
    const form=document.getElementById('contactForm'),notice=document.getElementById('formNotice');form.addEventListener('submit',async event=>{event.preventDefault();notice.textContent='Sending…';const payload=Object.fromEntries(new FormData(form));try{const response=await fetch('/api/contact',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});const result=await response.json();if(!response.ok)throw new Error(result.error||'Please try again.');form.reset();notice.textContent='Thanks — your message is with us. We’ll be in touch soon.';}catch(error){notice.textContent=error.message||'Something went wrong. Please try again.';}});
    if(!navigator.doNotTrack){fetch('/api/track',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({path:location.pathname,referrer:document.referrer})}).catch(()=>{});}
  </script>
</body>
</html>
