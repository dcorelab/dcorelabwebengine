                        <a href="/contactus" class="btn btn-primary">Get Started</a>
                    </div>

                    <div class="pricing-card fade-in">
                        <h3 style="color: var(--accent-blue);">Professional</h3>
                        <p style="color: var(--text-light);">Most popular for businesses</p>
                        <div class="price">₹2L+</div>
                        <p style="color: var(--text-light); font-size: 0.9rem;">Full-featured solutions</p>
                        <a href="/contactus" class="btn btn-primary">Get Started</a>
                    </div>

                    <div class="pricing-card fade-in">
