            </div>
        </section>

        <!-- Pricing -->
        <section class="section">
            <div class="pricing-section">
                <h2 class="section-title fade-in">Flexible Pricing Plans</h2>
                <div class="pricing-grid">
                    <div class="pricing-card fade-in">
