<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/asset/core_lab__2_-removebg-preview.png" type="image/x-icon" />
    
    <title><%= title %></title>
    <meta name="description" content="Learn about Dcore Lab - a leading SaaS development and digital solutions agency in Kolkata, West Bengal. Meet our expert team dedicated to your success.">
    <meta name="keywords" content="about dcore lab, our team, company mission, digital solutions agency">
    <meta name="robots" content="index, follow" />
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Alignment & Responsive Fixes -->
    <link rel="stylesheet" href="/styles/fixes.css" />
    
    <style>
        :root {
            --primary-light: #F8FAFC;
            --secondary-light: #F1F5F9;
            --tertiary-light: #E2E8F0;
            --accent-blue: #3b48f6;
            --accent-purple: #3470b4;
            --accent-pink: #5032d6;
            --accent-cyan: #06B6D4;
            --accent-emerald: #10B981;
            --text-dark: #1E293B;
            --text-light: #475569;
            --border-light: #E2E8F0;
            --shadow: 0 10px 35px rgba(59, 130, 246, 0.15);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: linear-gradient(135deg, var(--primary-light) 0%, #FFFFFF 50%, #F0F9FF 100%);
            color: var(--text-dark);
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            position: relative;
        }

        html {
            scroll-behavior: smooth;
        }

        /* ANIMATED DOTTED BACKGROUND */
        #animated-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
        }

        .dot {
            position: absolute;
            width: 3px;
            height: 3px;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.6), rgba(139, 92, 246, 0.3));
            border-radius: 50%;
            animation: float 20s infinite ease-in-out;
        }

        @keyframes float {
            0% { transform: translateY(0px) translateX(0px); opacity: 0.3; }
            50% { transform: translateY(-50px) translateX(30px); opacity: 1; }
            100% { transform: translateY(0px) translateX(0px); opacity: 0.3; }
        }

        .line-connector {
            position: absolute;
            background: linear-gradient(90deg, rgba(59, 130, 246, 0.4), rgba(139, 92, 246, 0.2), transparent);
            animation: drawLine 15s infinite ease-in-out;
        }

        @keyframes drawLine {
            0% { opacity: 0.2; transform: scaleX(0); }
            50% { opacity: 0.8; transform: scaleX(1); }
            100% { opacity: 0.2; transform: scaleX(1); }
        }

        /* NAVIGATION */
        nav.navbar {
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(10px);
            border-bottom: 2px solid var(--border-light);
            transition: all 0.3s;
            z-index: 1000;
        }

        nav.navbar.scrolled {
            box-shadow: var(--shadow);
            padding: 0.5rem 0;
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            font-weight: 700;
        }

        .video_logo {
            width: 50px;
            height: 50px;
            border-radius: 8px;
        }

        .nav-link {
            color: var(--text-dark) !important;
            font-weight: 500;
            margin: 0 1rem;
            position: relative;
            transition: color 0.3s;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            background: var(--accent-blue);
            bottom: -5px;
            left: 0;
            transition: width 0.3s;
        }

        .nav-link:hover::after,
        .nav-link.active::after {
            width: 100%;
        }

        .nav-cta {
            background: var(--accent-blue);
            color: white !important;
            padding: 0.6rem 1.5rem !important;
            border-radius: 8px;
            transition: all 0.3s;
        }

        .nav-cta:hover {
            background: var(--accent-purple);
            transform: translateY(-2px);
            box-shadow: var(--shadow);
        }

        /* CONTENT */
        .content-wrapper {
            position: relative;
            z-index: 2;
        }

        .hero-section {
            padding: 8rem 2rem 2rem;
            text-align: center;
            margin-top: 3rem;
        }

        .hero-section h1 {
            font-size: 3.5rem;
            font-weight: 800;
            margin-bottom: 1rem;
            background: linear-gradient(135deg, var(--accent-blue), var(--accent-purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-section p {
            font-size: 1.25rem;
            color: var(--text-light);
            max-width: 700px;
            margin: 0 auto;
            margin-bottom: 2rem;
        }

        .section {
            padding: 4rem 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-title {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 3rem;
            text-align: center;
        }

        .card-item {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(10px);
            border: 1px solid var(--border-light);
            border-radius: 12px;
            padding: 2rem;
            margin-bottom: 2rem;
            transition: all 0.3s;
        }

        .card-item:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow);
        }

        .card-item h3 {
            color: var(--accent-blue);
            margin-bottom: 1rem;
            font-weight: 700;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 2rem;
            margin: 2rem 0;
        }

        .stat-card {
            text-align: center;
            padding: 2rem;
            background: rgba(59, 130, 246, 0.1);
            border-radius: 12px;
            border: 1px solid rgba(59, 130, 246, 0.2);
        }

        .stat-number {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--accent-blue);
        }

        .stat-label {
            color: var(--text-light);
            margin-top: 0.5rem;
        }

        .team-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
        }

        .team-member {
            text-align: center;
            background: rgba(255, 255, 255, 0.7);
            padding: 2rem;
            border-radius: 12px;
            border: 1px solid var(--border-light);
            transition: all 0.3s;
        }

        .team-member:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow);
        }

        .team-member-avatar {
            width: 120px;
            height: 120px;
            background: linear-gradient(135deg, var(--accent-blue), var(--accent-purple));
            border-radius: 50%;
            margin: 0 auto 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 3rem;
        }

        .team-member h4 {
            color: var(--text-dark);
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .team-member p {
            color: var(--text-light);
            font-size: 0.9rem;
        }

        .fade-in {
            opacity: 0;
            transform: translateY(20px);
            animation: fadeInUp 0.8s ease forwards;
        }

        @keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 768px) {
            .hero-section h1 {
                font-size: 2rem;
            }

            .section-title {
                font-size: 1.75rem;
            }

            .nav-link {
                margin: 0.5rem 0;
            }
        }
    </style>
</head>

<body>
    <div id="animated-bg"></div>
    
    <div class="content-wrapper">
        <%- include('./partials/navbar') %>

        <!-- Hero Section -->
        <section class="hero-section">
            <h1>About Dcore Lab</h1>
            <p>We are a team of passionate engineers, designers, and strategists dedicated to transforming businesses through innovative digital solutions and cutting-edge technology.</p>
        </section>

        <!-- Our Story -->
        <section class="section">
            <h2 class="section-title fade-in">Our Story</h2>
            <div class="card-item fade-in">
                <h3>From Vision to Reality</h3>
                <p>Founded with a mission to bring world-class digital solutions to businesses of all sizes, Dcore Lab has grown into a trusted partner for SaaS development, digital marketing, and web solutions. We believe in the power of technology to transform businesses and empower entrepreneurs.</p>
            </div>
        </section>

        <!-- Mission & Values -->
        <section class="section">
            <h2 class="section-title fade-in">Our Mission & Values</h2>
            <div class="row">
                <div class="col-md-6">
                    <div class="card-item fade-in">
                        <h3><i class="fas fa-target"></i> Our Mission</h3>
                        <p>To deliver innovative, scalable, and sustainable digital solutions that help businesses thrive in the digital age while maintaining the highest standards of quality and customer satisfaction.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card-item fade-in">
                        <h3><i class="fas fa-heart"></i> Our Values</h3>
                        <ul style="color: var(--text-light); line-height: 2;">
                            <li><strong>Excellence:</strong> We strive for perfection in every project</li>
                            <li><strong>Innovation:</strong> We embrace cutting-edge technologies</li>
                            <li><strong>Integrity:</strong> We believe in honest and transparent communication</li>
                            <li><strong>Impact:</strong> We measure success by our clients' growth</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <!-- Statistics -->
        <section class="section">
            <h2 class="section-title fade-in">By The Numbers</h2>
            <div class="stats-grid">
                <div class="stat-card fade-in">
                    <div class="stat-number">50+</div>
                    <div class="stat-label">Projects Delivered</div>
                </div>
                <div class="stat-card fade-in">
                    <div class="stat-number">30+</div>
                    <div class="stat-label">Happy Clients</div>
                </div>
                <div class="stat-card fade-in">
                    <div class="stat-number">15+</div>
                    <div class="stat-label">Team Members</div>
                </div>
                <div class="stat-card fade-in">
                    <div class="stat-number">5+</div>
                    <div class="stat-label">Years Experience</div>
                </div>
            </div>
        </section>

        <!-- Our Team -->
        <section class="section">
            <h2 class="section-title fade-in">Our Team</h2>
            <div class="team-grid">
                <div class="team-member fade-in">
                    <div class="team-member-avatar"><i class="fas fa-user"></i></div>
                    <h4>Founder & CEO</h4>
                    <p>Visionary leader with 10+ years in tech</p>
                </div>
                <div class="team-member fade-in">
                    <div class="team-member-avatar"><i class="fas fa-code"></i></div>
                    <h4>Lead Developer</h4>
                    <p>Expert in SaaS architecture & scalability</p>
                </div>
                <div class="team-member fade-in">
                    <div class="team-member-avatar"><i class="fas fa-pen"></i></div>
                    <h4>Creative Director</h4>
                    <p>Design & brand strategy specialist</p>
                </div>
                <div class="team-member fade-in">
                    <div class="team-member-avatar"><i class="fas fa-chart-line"></i></div>
                    <h4>Growth Strategist</h4>
                    <p>Digital marketing & SEO expert</p>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="section" style="text-align: center; margin-bottom: 4rem;">
            <h2 class="section-title fade-in">Ready to Collaborate?</h2>
            <p style="color: var(--text-light); font-size: 1.1rem; margin-bottom: 2rem;">Let's work together to bring your vision to life.</p>
            <a href="/contactus" class="btn btn-primary fade-in" style="background: var(--accent-blue); border: none; padding: 0.8rem 2rem; font-weight: 600; border-radius: 8px;">Get In Touch</a>
        </section>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Animated Background
        const dotCount = 15;
        const lineCount = 8;
        const bgContainer = document.getElementById('animated-bg');

        for (let i = 0; i < dotCount; i++) {
            const dot = document.createElement('div');
            dot.className = 'dot';
            dot.style.left = Math.random() * 100 + '%';
            dot.style.top = Math.random() * 100 + '%';
            dot.style.animationDelay = Math.random() * 20 + 's';
            dot.style.animationDuration = (10 + Math.random() * 20) + 's';
            bgContainer.appendChild(dot);
        }

        // Navigation scroll effect
        window.addEventListener('scroll', () => {
            const nav = document.querySelector('nav');
            if (window.scrollY > 50) {
                nav.classList.add('scrolled');
            } else {
                nav.classList.remove('scrolled');
            }
        });

        // Fade in on scroll
        const observerOptions = { threshold: 0.1, rootMargin: '0px 0px -100px 0px' };
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                }
            });
        }, observerOptions);

        document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
    </script>
<!-- Include Footer -->
<!-- Include Chatbot Widget -->
<%- include('./partials/chatbot-widget') %>

<%- include('./partials/footer') %>

</body>
</html>
